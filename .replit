modules = ["python-3.11"]

[nix]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Pygame VNC"

[[workflows.workflow]]
name = "Pygame VNC"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python project/main.py"

[workflows.workflow.metadata]
outputType = "vnc"
